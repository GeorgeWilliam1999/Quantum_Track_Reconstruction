\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Optimal relative threshold $\tau ^\star $ vs $T$. The $F_1$ optimum jumps from $\tau \approx 0.05$ at $T\le 200$ to $0.30$--$0.40$ at $T\ge 500$ --- the regime where the high-FR plateau is large enough that an efficiency sacrifice pays off in purity.}}{9}{figure.7}\protected@file@percent }
\newlabel{fig:besttau}{{7}{9}{Optimal relative threshold $\tau ^\star $ vs $T$. The $F_1$ optimum jumps from $\tau \approx 0.05$ at $T\le 200$ to $0.30$--$0.40$ at $T\ge 500$ --- the regime where the high-FR plateau is large enough that an efficiency sacrifice pays off in purity}{figure.7}{}}
