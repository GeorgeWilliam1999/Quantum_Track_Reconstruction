\newlabel{fig:fidelity}{{4}{6}{Solution fidelity: cosine $\cos (\sC , \sQ )$, relative $L_2$ error, and Jaccard overlap of activation sets vs.\ $T$. Cosine fidelity collapses by $T = 100$ while the activation-set Jaccard stays $\ge 0.94$ to $T = 100$ --- the discrepancy is amplitude shaping, not wrong segments, at small $T$}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Segment false rate vs $T$ under the two threshold conventions, E1 statevector readout. \textbf  {(a) Absolute} $\tau $ on $\texttt  {sol\_Q\_scaled}$: the curve is flat for $\tau \in [0.2,\,1.0]$ at $T \ge 100$ because $q_{\qopname  \relax m{max}} \gg 1$; only $\tau _{\mathrm  {abs}} \gtrsim 3$ begins to clip the false-segment mass. \textbf  {(b) Relative} $\tau \cdot q_{\qopname  \relax m{max}}$: a single dimensionless $\tau \approx 0.40$ collapses the FR by two orders of magnitude at high $T$, restoring classical-comparable purity.}}{6}{figure.5}\protected@file@percent }
\newlabel{fig:absvsrel}{{5}{6}{Segment false rate vs $T$ under the two threshold conventions, E1 statevector readout. \textbf {(a) Absolute} $\tau $ on $\texttt {sol\_Q\_scaled}$: the curve is flat for $\tau \in [0.2,\,1.0]$ at $T \ge 100$ because $q_{\max } \gg 1$; only $\tau _{\mathrm {abs}} \gtrsim 3$ begins to clip the false-segment mass. \textbf {(b) Relative} $\tau \cdot q_{\max }$: a single dimensionless $\tau \approx 0.40$ collapses the FR by two orders of magnitude at high $T$, restoring classical-comparable purity}{figure.5}{}}
