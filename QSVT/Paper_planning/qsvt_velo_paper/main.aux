\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Spectral twins. A true fragment of a broken track (top) and an accidental false pair (bottom) have isomorphic compatibility graphs, hence identical $2\times 2$ sub-blocks of $A$, hence exactly the same eigenvalues and amplitudes. Every function of $A$ treats them identically; this is the floor theorem, and under noise these twins become a population large enough to cap segment efficiency (section\nobreakspace  {}\ref  {sec:fit}).\relax }}{20}{figure.caption.11}\protected@file@percent }
\newlabel{fig:twins}{{10}{20}{Spectral twins. A true fragment of a broken track (top) and an accidental false pair (bottom) have isomorphic compatibility graphs, hence identical $2\times 2$ sub-blocks of $A$, hence exactly the same eigenvalues and amplitudes. Every function of $A$ treats them identically; this is the floor theorem, and under noise these twins become a population large enough to cap segment efficiency (section~\ref {sec:fit}).\relax }{figure.caption.11}{}}
