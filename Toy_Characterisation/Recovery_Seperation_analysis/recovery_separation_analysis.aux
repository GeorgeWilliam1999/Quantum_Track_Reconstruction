\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Visual guide to matrix structure and Gershgorin disc analysis. \emph  {Top row}: well-separated 2-track event --- (a)\nobreakspace  {}block-diagonal matrix with 12 off-diagonal entries, (b)\nobreakspace  {}Gershgorin discs safely within the positive half-plane, (c)\nobreakspace  {}diagonal dominance satisfied ($\rho _i < 1$ for all rows). \emph  {Bottom row}: near-coincident 2-track event --- (d)\nobreakspace  {}dense cross-coupling (48 off-diagonal entries), (e)\nobreakspace  {}enlarged discs crossing zero with one negative eigenvalue (red\nobreakspace  {}$\triangledown $), (f)\nobreakspace  {}diagonal dominance violated ($\rho _i \geq 1$, red labels), confirming indefiniteness.\relax }}{13}{figure.caption.23}\protected@file@percent }
\newlabel{fig:gershgorin_visual}{{3}{13}{Visual guide to matrix structure and Gershgorin disc analysis. \emph {Top row}: well-separated 2-track event --- (a)~block-diagonal matrix with 12 off-diagonal entries, (b)~Gershgorin discs safely within the positive half-plane, (c)~diagonal dominance satisfied ($\rho _i < 1$ for all rows). \emph {Bottom row}: near-coincident 2-track event --- (d)~dense cross-coupling (48 off-diagonal entries), (e)~enlarged discs crossing zero with one negative eigenvalue (red~$\triangledown $), (f)~diagonal dominance violated ($\rho _i \geq 1$, red labels), confirming indefiniteness.\relax }{figure.caption.23}{}}
