\@writefile{toc}{\contentsline {subsection}{\numberline {6.1}Occupancy Histograms Under Noise}{7}{subsection.6.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Clean-baseline occupancy histograms ($2 \times 3$ grid: rows = angle settings, columns = track counts). Dashed lines mark the expected $n$ and $2n$ peaks. Sub-peaks visible at $\pm 0.2$\,rad (top row) are the segment-grass artefact.\relax }}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:occ_clean}{{7}{7}{Clean-baseline occupancy histograms ($2 \times 3$ grid: rows = angle settings, columns = track counts). Dashed lines mark the expected $n$ and $2n$ peaks. Sub-peaks visible at $\pm 0.2$\,rad (top row) are the segment-grass artefact.\relax }{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Occupancy distributions for $\pm 0.2$\,rad under various noise conditions. Ghost hits shift mass rightward (more segments per hit); dropped hits reduce the peak heights. The clean distribution (blue) is overlaid for reference.\relax }}{8}{figure.caption.9}\protected@file@percent }
\newlabel{fig:occ_noisy}{{8}{8}{Occupancy distributions for $\pm 0.2$\,rad under various noise conditions. Ghost hits shift mass rightward (more segments per hit); dropped hits reduce the peak heights. The clean distribution (blue) is overlaid for reference.\relax }{figure.caption.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}Anomalous Occupancy Fraction}{8}{subsection.6.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Anomalous occupancy fraction as a function of ghost rate (columns) and drop rate (rows). Upper panels: $\pm 0.2$\,rad; lower panels: $\pm 0.1$\,rad. Columns within each row correspond to increasing track multiplicity.\relax }}{8}{figure.caption.10}\protected@file@percent }
\newlabel{fig:heatmap_anom}{{9}{8}{Anomalous occupancy fraction as a function of ghost rate (columns) and drop rate (rows). Upper panels: $\pm 0.2$\,rad; lower panels: $\pm 0.1$\,rad. Columns within each row correspond to increasing track multiplicity.\relax }{figure.caption.10}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}Reconstruction Efficiency}{8}{subsection.6.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Reconstruction efficiency vs ghost rate and drop rate. Efficiency degrades primarily along the drop-rate axis. Ghost hits have minimal impact because the $\gamma $-term suppresses false segments effectively.\relax }}{9}{figure.caption.11}\protected@file@percent }
\newlabel{fig:heatmap_eff}{{10}{9}{Reconstruction efficiency vs ghost rate and drop rate. Efficiency degrades primarily along the drop-rate axis. Ghost hits have minimal impact because the $\gamma $-term suppresses false segments effectively.\relax }{figure.caption.11}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.4}Segment Count Growth}{9}{subsection.6.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Mean number of Hamiltonian segments vs ghost and drop rate. Ghost hits create additional segments with all hits in adjacent modules, leading to super-linear growth.\relax }}{10}{figure.caption.12}\protected@file@percent }
\newlabel{fig:heatmap_seg}{{11}{10}{Mean number of Hamiltonian segments vs ghost and drop rate. Ghost hits create additional segments with all hits in adjacent modules, leading to super-linear growth.\relax }{figure.caption.12}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.5}Activation Spectrum}{10}{subsection.6.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Mean activation of true (upper curves) and false (lower curves) segments. Left: varied ghost rate at zero drop. Right: varied drop rate at zero ghost. The gap between true and false narrows only with increasing drop rate.\relax }}{10}{figure.caption.13}\protected@file@percent }
\newlabel{fig:activation}{{12}{10}{Mean activation of true (upper curves) and false (lower curves) segments. Left: varied ghost rate at zero drop. Right: varied drop rate at zero ghost. The gap between true and false narrows only with increasing drop rate.\relax }{figure.caption.13}{}}
