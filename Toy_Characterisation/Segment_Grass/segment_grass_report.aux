\newlabel{fig:hits_per_module}{{6}{7}{Distribution of hits per module across 100~events for each angle setting. At $\pm 0.2$\,rad (blue), modules~3 and~4 show variable hit counts due to geometric clipping.\relax }{figure.caption.7}{}}
\@writefile{toc}{\contentsline {section}{\numberline {6}Systematic Sweep: Ghost Rate and Drop Rate}{7}{section.6}\protected@file@percent }
